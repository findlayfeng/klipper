# Base config file for a bridge on STM32F1 with a USB CDC console and one
# downstream port on a hardware UART.
#
# The console is the USB CDC carrier (the Communication interface default for
# this part); the bridge's UART ports are turned on by CONFIG_STM32_BRIDGE_SERIAL
# and then ticked one per USART, so this target ticks exactly one: USART1, on
# PA10 (RX) / PA9 (TX). That exists to compile src/stm32/bridge_serial.c - the
# arch's UART backend (CONFIG_BRIDGE_PORT_SERIAL) - into the build gate. No
# `.test` dictionary references it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_MUX_SERIAL=y
CONFIG_STM32_BRIDGE_SERIAL=y
CONFIG_STM32_BRIDGE_SERIAL_USART1=y
