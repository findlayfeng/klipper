# Base config file for a bridge on STM32F446 with a USB CDC console and one
# downstream CAN port on the bxCAN controller.
#
# This is the topology the CAN bridge is built for: the F4 keeps its USB console
# on PA11/PA12 and puts CAN1 on PB8 (RX) / PB9 (TX), which the F1 cannot do - its
# USB peripheral and CAN1 RX0 share interrupt vector 20 (see
# CONFIG_STM32_BRIDGE_CAN_PB8_PB9's help).
#
# The port is CONFIG_BRIDGE_PORT_CAN (generic/bridge_can.c): a CAN controller
# handed to the bridge the way a USART is, with no node on the bus (no CANSERIAL,
# no MUX_CAN). It exists to compile that backend and the driver-without-node
# pipeline into the build gate. No `.test` dictionary references it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F446=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_MUX_SERIAL=y
CONFIG_STM32_BRIDGE_CAN_PB8_PB9=y
