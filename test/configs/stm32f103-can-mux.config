# Base config file for a CAN mux carrier (the bridge's CAN upstream).
#
# This target exists so the build gate actually compiles the `CONFIG_MUX_CAN`
# bodies in `src/generic/canserial.c`; no `.test` dictionary references it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_CANBUS_PA11_PA12=y
CONFIG_MUX_CAN=y
