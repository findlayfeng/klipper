# Base config file for STM32F1 over its USB CDC console, speaking the serial mux.
#
# This target exists so the build gate compiles the USB CDC carrier's mux wiring
# (src/generic/usb_cdc.c) and the MCU reset the restart command uses
# (`mcu_restart()`, src/generic/armcm_reset.c); no `.test` dictionary references
# it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_MUX_SERIAL=y
