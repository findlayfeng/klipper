# Base config file for STM32F1 over its USART console, speaking the serial mux.
#
# The UART counterpart of stm32f103-usb-mux.config: it covers the generic serial
# console's mux wiring (src/generic/serial_irq.c) and `mcu_restart()` on a
# micro-controller; no `.test` dictionary references it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_MUX_SERIAL=y
