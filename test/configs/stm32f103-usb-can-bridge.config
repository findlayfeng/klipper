# Base config file for a bridge on STM32F1 with a USB CDC console, one
# downstream port on a hardware UART and one on the bxCAN controller.
#
# The console is the USB CDC carrier (the Communication interface default for
# this part). The bridge's USART ports are turned on by
# CONFIG_STM32_BRIDGE_SERIAL and then ticked one per USART, so this target ticks
# exactly one: USART1, on PA10 (RX) / PA9 (TX). That compiles
# src/stm32/bridge_serial.c (CONFIG_BRIDGE_PORT_SERIAL) into the build gate.
#
# The CAN port is the other kind: CONFIG_STM32_BRIDGE_CAN_PB8_PB9 hands the
# bxCAN controller (PB8 RX / PB9 TX) to the bridge as a downstream port
# (CONFIG_BRIDGE_PORT_CAN, src/generic/bridge_can.c), so this target is the one
# that compiles the CAN backend and the driver without the CANserial node
# (CONFIG_CANBUS, not CONFIG_CANSERIAL). Its slot comes after the UART slots, so
# BRIDGE_UART_COUNT is 2 here. No `.test` dictionary references it.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_USBSERIAL=y
CONFIG_MUX_SERIAL=y
CONFIG_STM32_BRIDGE_SERIAL=y
CONFIG_STM32_BRIDGE_SERIAL_USART1=y
CONFIG_STM32_BRIDGE_CAN_PB8_PB9=y
