# Kconfig settings for compiling klipper as a host static library
#
# Copyright (C) 2026  Feng Cheng <i@pfeng.top>
#
# This file may be distributed under the terms of the GNU GPLv3 license.
#
# This configuration compiles only the core klipper firmware (scheduler,
# command parsing, console I/O) for the host processor as a static
# library with thread-safe I/O. It does NOT enable any peripherals
# (GPIO/SPI/I2C/ADC/PWM/sensors) - those are not implemented on host.

if MACH_HOST

config BOARD_DIRECTORY
    string
    default "host"

config HOST_SELECT
    bool
    default y

config HOST_LIBRARY_NAME
    string "Static library name"
    default "klipper_host"
    help
        Name of the generated static library (without lib/ .a prefix)

config HOST_FRAME_API
    bool "Hand whole protocol frames to the caller"
    default n
    help
        Adds klipper_host_output_frame(), which returns one complete message
        block per call instead of a byte stream. Klipper already produces
        whole frames, so with this the caller does not have to reassemble
        them, at the cost of a buffer big enough for the largest frame.

        The byte stream API stays available either way.

config HOST_BRIDGE_SERIAL
    bool "Bridge mode: add a serial port to the console"
    default n
    select BRIDGE
    select BRIDGE_PORT_SERIAL
    select MUX_SERIAL
    help
        Klipper has one console, and this library hands it to the caller
        through klipper_host_input()/klipper_host_output(). With this, the
        firmware also owns a serial port - another port on that console - and
        opens it during klipper_host_init().

        Off by default: the library then talks only through the
        klipper_host_*() API and opens no device.

config HOST_BRIDGE_SERIAL_PATH
    string "Serial port the bridge opens"
    depends on HOST_BRIDGE_SERIAL
    default "/dev/ttyACM0"
    help
        The tty opened at init. The host has no fixed list of ports to choose
        from, so this is a path rather than a choice; /dev/ttyACM0 is the
        conventional Linux default (klipper's example configs all name it).

config HOST_AR_LIBRARY
    bool "Build as AR static library (.a)"
    default y
    help
        Build the firmware as a static archive (.a) that can be
        linked into other applications.
        
        If disabled, builds a shared library (.so) instead.

config SERIAL
    default y

config CLOCK_FREQ
    int
    default 20000000

endif
