# Generic configuration options for serial ports
config SERIAL
    bool
config SERIAL_BAUD
    depends on SERIAL
    int "Baud rate for serial port" if LOW_LEVEL_OPTIONS
    default 250000
    help
        Specify the baud rate of the serial port. This should be set
        to 250000. Read the FAQ before changing this value.

# Generic configuration options for the serial mux (MUX) and for bridge mode
# (BRIDGE).
#
# MUX is the device half: a firmware that can be addressed inside a shared byte
# stream - it answers the scan/admin channel, adopts the node id it is handed,
# and handles an id collision the way the CAN code does
# (generic/canserial.c:can_id_conflict). Every firmware wants it, whatever
# carries the stream: MUX_SERIAL today, MUX_CAN to follow.
#
# MUX and MUX_SERIAL are capabilities, not per-arch selections: whoever has the
# wiring selects them, and an arch without the wiring simply leaves them off.
# The wiring lives with whoever carries the byte stream, so MUX_SERIAL is
# offered wherever that carrier is: the host library's console task
# (src/host/console.c, which HOST_MUX_SERIAL selects), the generic serial
# console every CONFIG_SERIAL arch shares (src/generic/serial_irq.c, calling
# mux_input/mux_send), and the linux process console (src/linux/console.c).
# That is the `depends on SERIAL` below - a transport whose console has no such
# wiring (ar100, pru have none of their own) has no SERIAL to depend on and
# cannot select it, so the choice never becomes a link error.
#
# The device also has to have an identity to answer a scan with, so MUX_SERIAL
# asks for one as well (`depends on HAVE_CHIPID || MACH_HOST || MACH_LINUX`). On
# a micro-controller the arch's chipid.c derives it from the chip id (the same
# HAVE_CHIPID the USB serial number uses); the host library takes it from its
# caller (klipper_host_set_uuid), and the linux process from its command line
# (-U), so MACH_HOST and MACH_LINUX are the other ways to have one. An arch with
# none of these - avr, hc32f460, simulator have no chipid.c - would answer with
# an all-zero identity, which names nothing: the option is not offered there
# rather than offered broken.
#
# It is off by default, on purpose. On a micro-controller it changes the
# console's wire format from bare frames to units, and units are not what the
# upstream klippy host speaks, so a board that turns it on is a board whose host
# has been told to expect the mux - a deliberate choice, never a default. The
# host library is the other side of that call: it is a library and the host
# decides, so HOST_MUX_SERIAL (src/host/Kconfig) turns it on there.
#
# BRIDGE is the router on top of it: it owns several ports - its own klipper
# instance is one of them - and forwards each addressed unit to the port that
# owns the id. A build that already has the mux half of a byte stream has what a
# bridge needs, so BRIDGE comes with it (the same `default y if` shape CANBUS
# uses below). MUX_SERIAL selects MUX, so the condition is `MUX && MUX_SERIAL`
# written as the one term that implies the other - spelling both out makes
# kconfig read `select MUX` and this default as a dependency loop. MUX_CAN does
# not exist yet; it will count here too once it does.
#
# Which ports the bridge can be given is the arch's to say. BRIDGE_PORT_SERIAL
# is that: this arch's UART objects (src/uart.c) can be handed to the bridge as
# downstream ports; nothing opens a device on its own. The host names which
# stream such an object carries, and at what rate, at configuration time.
config MUX
    bool
config MUX_SERIAL
    bool "Serial mux: address this console in a shared byte stream"
    depends on SERIAL
    depends on HAVE_CHIPID || MACH_HOST || MACH_LINUX
    select MUX
    help
        Make this build's console byte stream speak the serial mux: answer a
        scan with this device's identity, adopt the node id it is handed, head
        its own frames with the reply header, and shut down on an id collision
        (src/mux.c). A build that speaks the mux is also a bridge (BRIDGE's
        `default y if` below).

        Needs an identity to answer with: a micro-controller derives it from
        its chip id (the arch's chipid.c, HAVE_CHIPID), the host library takes
        it from its caller (klipper_host_set_uuid), and the linux process from
        its command line (-U). An arch whose identity would always be zero is
        not offered this option.

        Off by default. With it the console's wire format is units, not the
        bare frames the upstream klippy host speaks, so only a host that
        expects the mux should ever be pointed at this board.
config BRIDGE
    bool
    select MUX
    default y if MUX_SERIAL
config BRIDGE_PORT_SERIAL
    bool

# The byte-stream UART object layer (src/uart.c): an oid a host creates at
# configuration time, the line rate it asked for, and the seam an arch fills.
config UART
    bool
# A byte stream an arch can attach to a UART object: the host library's tty
# backend (src/host/bridge.c) today. An arch selects this once it can hand a
# UART object out as a bridge port.
config SERIAL_UART
    bool
    select UART
    default y if BRIDGE_PORT_SERIAL

# Generic configuration options for USB
config USBSERIAL
    bool
config USBCANBUS
    bool
config USB
    bool
    default y if USBSERIAL || USBCANBUS
config USB_VENDOR_ID
    default 0x1d50
config USB_DEVICE_ID
    default 0x614e
config USB_SERIAL_NUMBER_CHIPID
    depends on USB && HAVE_CHIPID
    default y
config USB_SERIAL_NUMBER
    default "12345"

menu "USB ids"
    depends on USB && LOW_LEVEL_OPTIONS
config USB_VENDOR_ID
    hex "USB vendor ID" if USBSERIAL
config USB_DEVICE_ID
    hex "USB device ID" if USBSERIAL
config USB_SERIAL_NUMBER_CHIPID
    bool "USB serial number from CHIPID" if HAVE_CHIPID
config USB_SERIAL_NUMBER
    string "USB serial number" if !USB_SERIAL_NUMBER_CHIPID
endmenu

